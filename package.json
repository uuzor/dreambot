{
  "name": "dreampilot",
  "version": "0.1.0",
  "private": true,
  "description": "DreamPilot - a multi-user Telegram trading agent for autonomous perps strategies on DreamDEX (Somnia).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "bot": "npm run dev -w @dreampilot/bot",
    "worker": "npm run dev -w @dreampilot/worker",
    "migrate": "npm run migrate -w @dreampilot/store",
    "doctor": "npm run doctor -w @dreampilot/somnia"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.1.0"
  }
}
