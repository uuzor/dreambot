# ── Telegram ────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram numeric user ids allowed to use the bot. Empty = open.
WHITELIST_USER_IDS=

# ── Network ─────────────────────────────────────────────────────────────────
# Perps run on the Hideki testnet (chain 50383) where the DreamDEX app and Perps
# Arena live. NETWORK=mainnet is refused: there are no perp pools there.
NETWORK=hideki

# ── Custody (DreamPilot never holds user funds) ──────────────────────────────
# 32-byte hex key (openssl rand -hex 32). Encrypts each user's per-user bot key
# at rest. Losing it makes every stored bot key unreadable.
MASTER_ENCRYPTION_KEY=

# ── Database ────────────────────────────────────────────────────────────────
# Postgres connection string. When unset the bot runs on an in-memory store
# (handy for a first look; state is lost on restart).
DATABASE_URL=
# Max connections per process pool. Default 4, which suits serverless instances
# that each open their own pool. A long-running bot process can raise it.
PG_POOL_MAX=

# ── Queue (autonomous agent workers) ────────────────────────────────────────
# Redis connection for BullMQ. When unset, agents are driven by an in-process
# scheduler inside the bot instead of separate workers.
REDIS_URL=

# ── Agent intelligence ──────────────────────────────────────────────────────
# Optional. When set, the "AI Trader" agent uses an LLM to propose trades; the
# deterministic risk engine still approves or rejects every proposal. When
# unset, the AI Trader falls back to a rules-based momentum reading.
ANTHROPIC_API_KEY=
DREAMPILOT_MODEL=claude-sonnet-4-5

# ── Safety ──────────────────────────────────────────────────────────────────
# Global default: true means agents log intended orders but send nothing.
# A user can never flip this off; it is the operator's master switch.
AGENTS_DRY_RUN=true
LOG_LEVEL=info

# ── Web dashboard ───────────────────────────────────────────────────────────
# Which account the dashboard *renders*. This is a reader-only convenience for a
# single-user local run; it never grants trade authority. Signing in with
# Telegram is what lets a dashboard visitor act. Defaults to the demo id, and
# the dashboard serves demo data when DATABASE_URL is unset.
DASHBOARD_TELEGRAM_ID=

# Bot handle without the @, used to build the "Connect Telegram" links on the
# dashboard and landing page. Unset hides the links rather than showing dead ones.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# HMAC key for the ?start= token in those links, so the bot can trust that the
# hand-off came from the dashboard. Unset falls back to a plain bot link.
DASHBOARD_LINK_SECRET=

# Signs the web session cookie. Without it the dashboard cannot sign anyone in
# and every control route refuses, which is the safe default: a deployment that
# forgets this is read-only, not open. Use a long random string
# (openssl rand -hex 32). Rotating it signs everyone out.
DASHBOARD_SESSION_SECRET=
# Set to "true" only to sign in over plain http on localhost; the cookie is
# Secure by default.
DASHBOARD_COOKIE_INSECURE=
